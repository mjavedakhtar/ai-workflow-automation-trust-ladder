# Copy to .env and fill in. Never commit .env.

# Required for live Gemini agents. Leave empty to run the deterministic mock LLM
# (policy, HITL, ledger, and execution still work — useful for forks and CI).
GOOGLE_API_KEY=

# gemini | mock | auto  (auto = Gemini if GOOGLE_API_KEY is set, else mock)
LLM_MODE=auto
GEMINI_MODEL=gemini-3.8-flash

# Demo API key. Send as X-API-Key. Change before any shared deployment.
API_KEY=dev-change-me

# HMAC key for the hash-chained audit ledger. Change before any shared deployment.
LEDGER_SIGNING_KEY=dev-ledger-change-me

# sqlite (default, zero-ops) or postgresql+psycopg://user:pass@localhost:5432/trustladder
DATABASE_URL=sqlite:///./backend/data/runtime/trustladder.db
CHECKPOINT_PATH=./backend/data/runtime/checkpoints.sqlite

# Comma-separated origins. Include the prototype origin if you host it separately.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

LOG_LEVEL=INFO
